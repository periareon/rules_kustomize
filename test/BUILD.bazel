load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

# buildifier: disable=bzl-visibility
load("//kustomize/private:versions.bzl", "DEFAULT_VERSION")
load("kustomize_diff_test.bzl", "kustomize_diff_test")

# Must match the `kustomize_dev.toolchain(name = "kustomize_pinned_toolchains", ...)` tag in MODULE.bazel.
PINNED_VERSION = "5.7.1"

# The golden file each kustomization's built result is compared against,
# keyed by the name of its `kustomize_diff_test`.
GOLDEN_FILES = {
    "generated_kustomization": "//test/testdata/generated/kustomization:golden.yaml",
    "functions": "testdata/functions/golden.yaml",
    "generated_resource": "//test/testdata/generated/resource:golden.yaml",
    "helm": "testdata/helm/golden.yaml",
    "overlay": "testdata/overlay/golden.yaml",
    "plugins": "testdata/plugins/golden.yaml",
    "remote": "testdata/remote/golden.yaml",
    "remote_helm": "testdata/remote_helm/golden.yaml",
    "simple": "testdata/simple/golden.yaml",
}

kustomize_diff_test(
    name = "simple",
    srcs = [
        "testdata/simple/config-bindings",
    ],
    # Exercise the pass-through of extra arguments; this one is harmless.
    args = ["--stack-trace"],
    golden_file = GOLDEN_FILES["simple"],
)

kustomize_diff_test(
    name = "generated_kustomization",
    srcs = [
        "//test/testdata/generated/kustomization:bindings.env",
    ],
    golden_file = GOLDEN_FILES["generated_kustomization"],
    kustomization_file = "//test/testdata/generated/kustomization:kustomization.yaml",
)

kustomize_diff_test(
    name = "generated_resource",
    srcs = [
        "//test/testdata/generated/resource:bindings.env",
    ],
    golden_file = GOLDEN_FILES["generated_resource"],
    kustomization_file = "//test/testdata/generated/resource:kustomization.yaml",
)

kustomize_diff_test(
    name = "overlay",
    srcs = [
        "testdata/overlay/pod.yaml",
    ],
    # Exercise the relaxed load restrictor; the other tests rely on
    # kustomize's default of confining loads to the kustomization root.
    args = [
        "--load-restrictor",
        "LoadRestrictionsNone",
    ],
    golden_file = GOLDEN_FILES["overlay"],
    deps = [
        ":simple",
        "//test/testdata/components/extra-translations:extra_translations",
    ],
)

kustomize_diff_test(
    name = "helm",
    srcs = [
        "testdata/helm/pdb.yaml",
        "//test/testdata/helm/charts",
    ],
    golden_file = GOLDEN_FILES["helm"],
)

# A KRM exec function built by Bazel and placed at the path its function
# configuration names.
kustomize_diff_test(
    name = "functions",
    srcs = ["testdata/functions/shout.yaml"],
    # Exercise the pass-through of function environment variables; the
    # function doesn't read it.
    env = {"GREETING_STYLE": "loud"},
    executables = ["//test/functions:shouter"],
    golden_file = GOLDEN_FILES["functions"],
)

# A legacy exec plugin supplied per target, which the builder places in
# the plugin home it hands to kustomize.
kustomize_diff_test(
    name = "plugins",
    srcs = ["testdata/plugins/greeter.yaml"],
    golden_file = GOLDEN_FILES["plugins"],
    plugins = ["//test/plugins:greeter"],
)

# A remote base fetched by `http_archive`, placed below the kustomization
# root at the `include_prefix` it declares.
kustomize_diff_test(
    name = "remote",
    golden_file = GOLDEN_FILES["remote"],
    deps = ["@kustomize_hello_world//:helloWorld"],
)

# A chart fetched by rules_helm's `helm_import_repository` and unpacked at
# the default `chartHome`, so the `helmCharts` field inflates it without
# `helm pull`.
kustomize_diff_test(
    name = "remote_helm",
    golden_file = GOLDEN_FILES["remote_helm"],
    helm_charts = ["@minecraft_chart//:minecraft"],
)

# Copies the built results over the golden files above:
#
#     bazel run //test:regenerate_golden_files
go_library(
    name = "regenerate_golden_files_lib",
    srcs = ["regenerate_golden_files.go"],
    importpath = "github.com/UebelAndre/rules_kustomize/test/regenerate_golden_files",
    deps = ["@rules_go//go/runfiles"],
)

go_binary(
    name = "regenerate_golden_files",
    args = [
        "$(rlocationpath :{name}_resources.yaml)=$(rootpath {golden})".format(
            name = name,
            golden = golden,
        )
        for name, golden in GOLDEN_FILES.items()
    ],
    data = [":{}_resources.yaml".format(name) for name in GOLDEN_FILES] + GOLDEN_FILES.values(),
    embed = [":regenerate_golden_files_lib"],
    pure = "on",
)

# A kustomization target stands for its kustomization file, so other
# targets can name it in `data` or expand its rlocationpath.
diff_test(
    name = "kustomization_output_test",
    size = "small",
    file1 = ":simple",
    file2 = "testdata/simple/kustomization.yaml",
)

# Toolchain resolution and the `KUSTOMIZE` make variable.
genrule(
    name = "toolchain_version",
    outs = ["toolchain_version.txt"],
    cmd = "$(KUSTOMIZE) version > $@",
    toolchains = ["//kustomize:current_toolchain"],
)

write_file(
    name = "expected_toolchain_version",
    out = "expected_toolchain_version.txt",
    content = [
        "v" + DEFAULT_VERSION,
        "",
    ],
)

diff_test(
    name = "toolchain_version_test",
    size = "small",
    file1 = ":toolchain_version",
    file2 = ":expected_toolchain_version",
)

# The host repository created by the default `kustomize.host_tools()` tag.
genrule(
    name = "host_version",
    outs = ["host_version.txt"],
    cmd = "$(execpath @kustomize//:kustomize) version > $@",
    tools = ["@kustomize"],
)

diff_test(
    name = "host_version_test",
    size = "small",
    file1 = ":host_version",
    file2 = ":expected_toolchain_version",
)

# A version without checksums in `kustomize/private/versions.bzl`, resolved by
# the extension at fetch time (and persisted as lockfile facts on Bazel 8.5+).
genrule(
    name = "pinned_version",
    outs = ["pinned_version.txt"],
    cmd = "$(execpath @kustomize_pinned//:kustomize) version > $@",
    tools = ["@kustomize_pinned//:kustomize"],
)

write_file(
    name = "expected_pinned_version",
    out = "expected_pinned_version.txt",
    content = [
        "v" + PINNED_VERSION,
        "",
    ],
)

diff_test(
    name = "pinned_version_test",
    size = "small",
    file1 = ":pinned_version",
    file2 = ":expected_pinned_version",
)

# The launcher in front of the host binary honors `BUILD_WORKING_DIRECTORY`.
# The sandbox presents the inputs as symbolic links pointing outside the
# kustomization root, so the default load restrictor must be relaxed here.
genrule(
    name = "launcher_build",
    srcs = [
        "testdata/simple/config-bindings",
        "testdata/simple/kustomization.yaml",
    ],
    outs = ["launcher_build.yaml"],
    cmd = "BUILD_WORKING_DIRECTORY=\"$$(dirname $(execpath testdata/simple/kustomization.yaml))\" $(execpath @kustomize//:kustomize) build --load-restrictor LoadRestrictionsNone . > $@",
    tools = ["@kustomize"],
)

diff_test(
    name = "launcher_build_test",
    size = "small",
    file1 = ":launcher_build",
    file2 = "testdata/simple/golden.yaml",
)

load("@rules_helm//helm:defs.bzl", "helm_chart")
load("@rules_kustomize//kustomize:defs.bzl", "kustomization", "kustomized_resources")

# rules_helm packages the chart; kustomize's own `helmCharts` field
# inflates it, with the packaged archive unpacked below `charts/` in
# place of a download.
helm_chart(
    name = "chart",
    chart = "chart/Chart.yaml",
    templates = glob(["chart/templates/**"]),
    values = "chart/values.yaml",
)

kustomization(
    name = "def",
    src = "kustomization.yaml",
    helm_charts = [":chart"],
)

kustomized_resources(
    name = "greeter",
    kustomization = ":def",
)

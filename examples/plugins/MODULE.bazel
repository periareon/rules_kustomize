module(name = "rules_kustomize_examples_plugins")

bazel_dep(name = "rules_kustomize", version = "0.0.0")
local_path_override(
    module_name = "rules_kustomize",
    path = "../../",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_go", version = "0.65.0")

# The host platform's kustomize, which the custom toolchain below builds on.
kustomize = use_extension("@rules_kustomize//kustomize:extensions.bzl", "kustomize")
use_repo(kustomize, "kustomize")

# Registered ahead of the toolchains rules_kustomize registers, so every
# build in this workspace gets the plugin.
register_toolchains("//:toolchain")

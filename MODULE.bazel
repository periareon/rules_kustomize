module(
    name = "rules_kustomize",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_helm", version = "0.37.0")

kustomize = use_extension("//kustomize:extensions.bzl", "kustomize")
kustomize.toolchain()
kustomize.host_tools()
use_repo(
    kustomize,
    "kustomize",
    "kustomize_toolchains",
)

register_toolchains("@kustomize_toolchains//:all")

# A version without checked in checksums, so the fact persistence path is
# exercised by the tests. The hub is left unregistered.
kustomize_dev = use_extension("//kustomize:extensions.bzl", "kustomize", dev_dependency = True)
kustomize_dev.toolchain(
    name = "kustomize_pinned_toolchains",
    version = "5.7.1",
)
kustomize_dev.host_tools(
    name = "kustomize_pinned",
    toolchains = "kustomize_pinned_toolchains",
)
use_repo(
    kustomize_dev,
    "kustomize_pinned",
)

# Remote content for the tests, fetched while repositories are resolved
# rather than by kustomize at build time.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "kustomize_hello_world",
    build_file_content = """\
load("@rules_kustomize//kustomize:defs.bzl", "kustomization")

# Placed at `bases/helloWorld` below every kustomization depending on it.
kustomization(
    name = "helloWorld",
    src = "kustomization.yaml",
    include_prefix = "bases/helloWorld",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "kustomization.yaml",
        ],
    ),
    visibility = ["//visibility:public"],
)
""",
    dev_dependency = True,
    sha256 = "4ea5a974c46ad6efcde4fd9c339ab1bd278a80b6872dda2d1a366936e4638475",
    strip_prefix = "kustomize-kustomize-v5.8.1/examples/helloWorld",
    urls = ["https://github.com/kubernetes-sigs/kustomize/archive/refs/tags/kustomize/v5.8.1.tar.gz"],
)

helm_import_repository = use_repo_rule("@rules_helm//helm:defs.bzl", "helm_import_repository")

helm_import_repository(
    name = "minecraft_chart",
    chart_name = "minecraft",
    dev_dependency = True,
    repository = "https://itzg.github.io/minecraft-server-charts",
    sha256 = "4cd47bbc4f9a41ea3915b996ea85cec49efe6671a1cf5a7bef8ee159d6a76c09",
    version = "3.1.4",
)

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//kustomize/private:toolchain.bzl", "kustomize_toolchain_alias")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extensions.bzl",
    "kustomization.bzl",
    "kustomization_info.bzl",
    "kustomize.bzl",
    "kustomize_toolchain.bzl",
    "kustomized_resources.bzl",
])

toolchain_type(
    name = "toolchain_type",
)

kustomize_toolchain_alias(
    name = "current_toolchain",
    # Marked manual so that `bazel build //...` passes even if no
    # toolchain is registered.
    tags = ["manual"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        ":kustomization",
        ":kustomization_info",
        ":kustomize_toolchain",
        ":kustomized_resources",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = ["//kustomize/private:bzl_lib"],
)

bzl_library(
    name = "kustomization",
    srcs = ["kustomization.bzl"],
    deps = ["//kustomize/private:bzl_lib"],
)

bzl_library(
    name = "kustomization_info",
    srcs = ["kustomization_info.bzl"],
    deps = ["//kustomize/private:bzl_lib"],
)

bzl_library(
    name = "kustomize",
    srcs = ["kustomize.bzl"],
    deps = [
        ":kustomization",
        ":kustomization_info",
        ":kustomize_toolchain",
        ":kustomized_resources",
    ],
)

bzl_library(
    name = "kustomize_toolchain",
    srcs = ["kustomize_toolchain.bzl"],
    deps = ["//kustomize/private:bzl_lib"],
)

bzl_library(
    name = "kustomized_resources",
    srcs = ["kustomized_resources.bzl"],
    deps = ["//kustomize/private:bzl_lib"],
)

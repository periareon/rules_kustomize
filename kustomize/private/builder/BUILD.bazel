load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "builder_lib",
    srcs = ["main.go"],
    importpath = "github.com/UebelAndre/rules_kustomize/kustomize/private/builder",
    deps = ["//kustomize/private/fscopy"],
)

go_binary(
    name = "builder",
    embed = [":builder_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "builder_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":builder_lib"],
)

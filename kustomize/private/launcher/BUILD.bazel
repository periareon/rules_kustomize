    name = "launcher",
    srcs = [
        "main.go",
        "run_unix.go",
        "run_windows.go",
    ],
    importpath = "github.com/UebelAndre/rules_kustomize/kustomize/private/launcher",
    visibility = ["//visibility:public"],
    deps = ["@rules_go//go/runfiles"],
)

"""Repository rules backing the kustomize module extension."""

visibility("//kustomize/...")

def host_platform(repository_ctx):
    """Return the `{os}-{arch}` platform name of the host, as used in `PLATFORMS`.

    Args:
        repository_ctx (repository_ctx): The repository context.

    Returns:
        str: e.g. `linux-amd64`.
    """
    os_name = repository_ctx.os.name.lower()
    if os_name.startswith("linux"):
        os = "linux"
    elif os_name.startswith("mac os"):
        os = "darwin"
    elif os_name.find("windows") != -1:
        os = "windows"
    else:
        fail("Unrecognized host os: {}".format(repository_ctx.os.name))

    arch = repository_ctx.os.arch
    if arch in ("aarch64", "arm64"):
        arch = "arm64"
    elif arch in ("x86_64", "amd64"):
        arch = "amd64"

    return "{}-{}".format(os, arch)

def _repo_metadata(repository_ctx):
    # Bazel <8.3.0 lacks repository_ctx.repo_metadata
    if not hasattr(repository_ctx, "repo_metadata"):
        return None
    return repository_ctx.repo_metadata(reproducible = True)

_TOOLCHAINS_BUILD_HEADER = """\
# @generated by rules_kustomize
load("@rules_kustomize//kustomize:kustomize_toolchain.bzl", "kustomize_toolchain")

package(default_visibility = ["//visibility:public"])
"""

_TOOLCHAIN_TEMPLATE = """\
kustomize_toolchain(
    name = "{name}_toolchain",
    kustomize = "{kustomize}",
    version = "{version}",
)

toolchain(
    name = "{name}",
    exec_compatible_with = {exec_compatible_with},
    toolchain = ":{name}_toolchain",
    toolchain_type = "@rules_kustomize//kustomize:toolchain_type",
)
"""

def _kustomize_toolchains_repository_impl(repository_ctx):
    content = [_TOOLCHAINS_BUILD_HEADER]
    for name, kustomize in repository_ctx.attr.binaries.items():
        content.append(_TOOLCHAIN_TEMPLATE.format(
            name = name,
            kustomize = kustomize,
            exec_compatible_with = json.encode(repository_ctx.attr.exec_compatible_with.get(name, [])),
            version = repository_ctx.attr.version,
        ))

    repository_ctx.file("BUILD.bazel", "\n".join(content))

    return _repo_metadata(repository_ctx)

kustomize_toolchains_repository = repository_rule(
    implementation = _kustomize_toolchains_repository_impl,
    doc = """\
Generates the toolchain hub: a `kustomize_toolchain` and a `toolchain` per \
platform, so they can all be registered with `:all`.
""",
    attrs = {
        "binaries": attr.string_dict(
            doc = "The label of the kustomize binary for each toolchain name.",
            mandatory = True,
        ),
        "exec_compatible_with": attr.string_list_dict(
            doc = "Execution platform constraints, keyed by toolchain name.",
            mandatory = True,
        ),
        "version": attr.string(
            doc = "The kustomize version the binaries were built from, without a leading `v`.",
            mandatory = True,
        ),
    },
)

_HOST_BUILD_CONTENT = """\
# @generated by rules_kustomize
load("@rules_go//go:def.bzl", "go_binary")

package(default_visibility = ["//visibility:public"])

# The host platform's toolchain from the `@{hub}` hub.
alias(
    name = "toolchain",
    actual = "{toolchain}",
)

# Runs kustomize from the directory `bazel run` was invoked in. The
# launcher finds the binary through runfiles, so it also works when
# another binary or test executes it directly.
go_binary(
    name = "kustomize",
    data = [":toolchain"],
    embed = ["@rules_kustomize//kustomize/private/launcher"],
    pure = "on",
    toolchains = [":toolchain"],
    x_defs = {{
        "github.com/UebelAndre/rules_kustomize/kustomize/private/launcher.kustomizeRlocationpath": "$(KUSTOMIZE_RLOCATIONPATH)",
        "github.com/UebelAndre/rules_kustomize/kustomize/private/launcher.pluginHomeRlocationpath": "$(KUSTOMIZE_PLUGIN_HOME_RLOCATIONPATH)",
    }},
)
"""

def _kustomize_host_repository_impl(repository_ctx):
    platform = host_platform(repository_ctx)
    if platform not in repository_ctx.attr.platforms:
        fail("The `{}` kustomize toolchain hub has no toolchain for the host platform {}".format(
            repository_ctx.attr.hub,
            platform,
        ))

    repository_ctx.file("BUILD.bazel", _HOST_BUILD_CONTENT.format(
        hub = repository_ctx.attr.hub,
        toolchain = "@{}//:{}_toolchain".format(repository_ctx.attr.hub, platform.replace("-", "_")),
    ))

    return _repo_metadata(repository_ctx)

kustomize_host_repository = repository_rule(
    implementation = _kustomize_host_repository_impl,
    doc = """\
Creates a repository with a short name (`@kustomize` by default) exposing the \
host platform's kustomize as `//:kustomize`, behind a launcher suited to \
`bazel run`. The binary is the one a toolchain hub holds for the host platform.
""",
    attrs = {
        "hub": attr.string(
            doc = "The name of the toolchain hub repository to take the host platform's toolchain from.",
            mandatory = True,
        ),
        "platforms": attr.string_list(
            doc = "The platform names the hub holds toolchains for.",
            mandatory = True,
        ),
    },
)
